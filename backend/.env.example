# Server
PORT=5000
NODE_ENV=development

# Database (Local SQLite - self-contained)
DATABASE_PATH=./data/saturn3d.db

# Pure JWT Auth
JWT_SECRET=saturn-3d-secret-jwt-key-change-in-production-2026
